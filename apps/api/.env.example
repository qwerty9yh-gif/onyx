# Render service settings
NODE_ENV=production
PORT=10000

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Use a long random value in Render
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend and CORS
FRONTEND_URL=https://qwerty9yh-gif.github.io/onyx/
CORS_ORIGINS=https://qwerty9yh-gif.github.io,http://localhost:5173

# Optional integrations
REDIS_URL=
PRINTER_API_URL=
SYNC_INTERVAL=30

# Hubtel SMS (invoice & broadcast). SMS_ENABLED=false = dry-run (no real sends)
HUBTEL_API_KEY=
HUBTEL_SENDER_ID=
HUBTEL_BASE_URL=https://api.hubtel.com/v1
SMS_ENABLED=false
